# Watson's normal configuration path is the local onboarding and Settings UI.
# This file is optional: Settings can explicitly import it once to migrate
# credentials from an older private install. It is never required to install
# or start Watson, and it should never be committed after adding real values.

# Optional package-mirror compatibility values. Prefer placing only these in
# .watson-install.env (or point WATSON_INSTALL_COMPAT_FILE at another local
# file) when your network cannot reach public package registries.
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_CONFIG_REGISTRY=

# Optional one-time Settings import values. Blank examples are intentional:
# after import, Watson stores credentials in the macOS Keychain and keeps
# non-secret connection settings in its local SQLite database.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6
PEOPLE_EMAIL_DOMAIN=
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_USERNAME=
CLICKUP_API_TOKEN=
CLICKUP_CREATE_LIST_ID=
GCAL_CREDENTIALS_PATH=
GCAL_TOKEN_PATH=
FLOCK_PROFILE_DIR=
FLOCK_URL=https://web.flock.com/
FLOCK_USER_HANDLE=

# Optional local data migration values. Keep the live database local; choose
# any already-synced folder only for the backup destination.
WATSON_DATA_DIR=~/.watson
WATSON_BACKUP_DIR=
TZ=UTC
